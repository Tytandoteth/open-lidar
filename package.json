    "preview": "vite preview",
    "build:sites": "node scripts/build-sites.mjs",
    "build:sites-eu": "node scripts/build-sites-eu.mjs"
  },
  "dependencies": {
    "geotiff": "2.1.3",
    "lerc": "4.3.0",
    "maplibre-gl": "6.17.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
