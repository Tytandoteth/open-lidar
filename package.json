{
  "name": "open-lidar",
  "private": true,
  "version": "0.1.0",
  "description": "Search any place and swipe from satellite to bare-earth lidar to see what is under the trees.",
  "license": "MIT",
  "author": "Ty Blackard (https://tyblackard.com)",
  "homepage": "https://open-lidar.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tytandoteth/open-lidar.git"
  },
  "bugs": "https://github.com/Tytandoteth/open-lidar/issues",
  "keywords": [
    "lidar",
    "maplibre",
    "elevation",
    "archaeology",
    "hillshade",
    "dem"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
